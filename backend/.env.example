# Copiar a .env y completar. El .env NO se versiona.

# Base de datos (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/banco_anteojos
DB_USERNAME=postgres
DB_PASSWORD=

# Seguridad (JWT)
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Bootstrap del primer ADMIN (solo se usa si la tabla users está vacía)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare R2 (storage de imágenes, S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# 17TRACK (logística Vía Cargo)
TRACK17_API_KEY=
