# En el servidor: copiar como /opt/banco-anteojos/.env  y  chmod 600 .env
# NUNCA subir el .env real a GitHub.

# Dominio (temporal con sslip.io; después el real)
DOMAIN=201-32-131-186.sslip.io
ACME_EMAIL=sistema.gestion@fundacionhacerfuturo.org

# Generar con:  openssl rand -base64 32
# JWT_SECRET se usa como clave HMAC: necesita al menos 32 bytes.
DB_PASSWORD=
JWT_SECRET=

# Admin inicial (cambiar la contraseña después del primer login)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Operador inicial. OBLIGATORIA: reemplaza la contraseña de desarrollo del operador
# que siembra la migración V15 (se reescribe en cada arranque del backend).
OPERATOR_EMAIL=operador@bancodeanteojos.org
OPERATOR_PASSWORD=

# Cloudflare R2 — bucket de PRODUCCIÓN (privado: se sirve con URLs firmadas),
# token con permiso solo a ese bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

TRACK17_API_KEY=

# SMTP para notificaciones de turnos (RF-22). MAIL_HOST vacío = notificaciones desactivadas.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# Remitente; si queda vacío se usa MAIL_USERNAME.
MAIL_FROM=
